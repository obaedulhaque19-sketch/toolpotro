# ==============================================================================
# Toolpotro — Environment Variables Configuration
# Copy this file to .env for local development, or configure these keys in
# Render / Vercel / GitHub Actions Environment Settings before deploying.
# NEVER commit .env with real secrets to version control.
# ==============================================================================

# Firebase Web SDK Configuration (Loaded via import.meta.env in src/lib/firebase.ts)
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="toolpotro.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="toolpotro"
VITE_FIREBASE_STORAGE_BUCKET="toolpotro.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_firebase_app_id"
VITE_FIREBASE_DATABASE_ID="your_firestore_database_id"

# Primary Admin Email (Must match verified Firebase Auth user & Firestore rules)
VITE_ADMIN_EMAIL="obaedulhaque19@gmail.com"

# Server & Render Deployment Configuration
PORT="3000"
APP_URL="https://your-toolpotro-app.onrender.com"
KEEP_ALIVE_INTERVAL_MS="600000"

# GitHub Releases Storage (Server-Side Only — NEVER prefix with VITE_)
# Create a Fine-Grained or Classic PAT with repo/public_repo scope
GITHUB_TOKEN="ghp_your_github_personal_access_token"
GITHUB_REPO_OWNER="your_github_username"
GITHUB_REPO_NAME="toolpotro-releases"
GITHUB_RELEASE_TAG="toolpotro-assets"
